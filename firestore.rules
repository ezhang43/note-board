rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules, then Publish.
// Invite-only: each invited Google account can read and write its own board, and nothing else.
// To invite someone, add their Gmail address to the list below and publish the rules again.
service cloud.firestore {
  match /databases/{database}/documents {
    // The board, and everything under it (version history: versions/ and versionData/).
    match /boards/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email in ["ezhang43@gmail.com", "erikazhu95@gmail.com"]
        && request.auth.token.email_verified == true;
    }
  }
}
