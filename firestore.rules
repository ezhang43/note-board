rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules, then Publish.
// Open to everyone: any signed-in Google account can read and write its own board (and its
// version history), never anyone else's, except boards someone shared with it by link (below).
// Saves are capped so no one can fill the storage.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }
    // A saved board (the same JSON as on the device), well under Firestore's 1 MiB per document.
    function boardText(text) {
      return text is string && text.size() <= 900000;
    }

    // Deleting the account (review 137-A H5): the page deleting it first adds a marker to the board,
    // {deleting: 'started', client, updatedAt} (the boards stay in it), and once the shares are dealt
    // with replaces it with {deleting: 'done', client, updatedAt}, which holds no boards and stays.
    // While there is a marker, no board, version or new shared board can be saved under boards/{uid},
    // so the person's other pages can't put anything back; deleting still works. While 'started', only
    // the page that set it may change it (to put the boards back if deleting fails, or to finish), or
    // any page once it is over 10 minutes old (that page closed part-way). Once 'done', any page may
    // only set it 'done' again (going through deleting again: only the sign-in failed to go).
    function boardPath(uid) {
      return /databases/$(database)/documents/boards/$(uid);
    }
    function deleting(uid) {
      return exists(boardPath(uid)) && 'deleting' in get(boardPath(uid)).data;
    }

    // The board itself.
    match /boards/{uid} {
      function saved() {
        return request.resource.data.keys().hasOnly(['data', 'client', 'updatedAt'])
          && boardText(request.resource.data.data)
          && request.resource.data.client is string;
      }
      function marker() {
        let d = request.resource.data;
        return d.keys().hasOnly(['deleting', 'client', 'updatedAt', 'data'])
          && d.deleting in ['started', 'done']
          && d.client is string
          && d.updatedAt == request.time
          && (!('data' in d) || (d.deleting == 'started' && boardText(d.data)));
      }
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && (saved() || marker());
      allow update: if isOwner(uid) && (saved() || marker())
        && (!('deleting' in resource.data)
          || (resource.data.deleting == 'started'
            && (request.resource.data.client == resource.data.client
              || request.time > resource.data.updatedAt + duration.value(10, 'm')))
          || (resource.data.deleting == 'done' && marker() && request.resource.data.deleting == 'done'));
    }

    // Version history: the list (what the panel shows)...
    match /boards/{uid}/versions/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && !deleting(uid)
        && request.resource.data.keys().hasOnly(['savedAt', 'cards', 'columns', 'boards', 'hash', 'kind'])
        && request.resource.data.savedAt is number
        // Counts and a short fingerprint (job 173: they had no check); older copies of the app leave some out.
        && (!('cards' in request.resource.data) || request.resource.data.cards is number)
        && (!('columns' in request.resource.data) || request.resource.data.columns is number)
        && (!('boards' in request.resource.data) || request.resource.data.boards is number)
        && (!('hash' in request.resource.data) || (request.resource.data.hash is string && request.resource.data.hash.size() <= 100))
        // A version kept just before changes from another device replaced the boards (job #147).
        && (!('kind' in request.resource.data) || request.resource.data.kind == 'outside');
    }
    // ...and each version's board.
    match /boards/{uid}/versionData/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && !deleting(uid)
        && request.resource.data.keys().hasOnly(['data'])
        && boardText(request.resource.data.data);
    }

    // ---------- Shared boards (editing together) ----------
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Each person's list of the shared boards they have (shared by them or joined).
    match /boards/{uid}/shared/{sid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && !deleting(uid) && request.resource.data.keys().hasOnly(['joinedAt'])
        && (!('joinedAt' in request.resource.data) || request.resource.data.joinedAt is timestamp);
    }

    // A shared board (with the boards inside it): only the people it is shared with can read it, and
    // only its editors change it. Only the person who shared it can change its links, change someone's
    // role, remove people or delete it.
    //
    // Roles (job 161): each member record has a role, 'edit', 'comment' or 'view'; one from before
    // roles has none, which counts as 'edit'. Each role has its own secret link key, kept in
    // shared/{sid}/private/links ({edit, comment, view}, each a key or null when off), which only
    // editors can read. A share from before roles keeps its edit key in the share itself (`link`)
    // until its owner's app moves it. Joining proves the key in shared/{sid}/joins/{uid}, which nobody
    // can read, and the member record must have the role that matches the key. Once a comment or view
    // link was ever made, those fields stay in the links record ("roles in use"): from then on the
    // share holds no key, and a key in a member record (as the app before roles writes it) lets nobody
    // in, as every member can read those records.
    match /shared/{sid} {
      function sharePath() {
        return /databases/$(database)/documents/shared/$(sid);
      }
      function memberPath(uid) {
        return /databases/$(database)/documents/shared/$(sid)/members/$(uid);
      }
      function linksPath() {
        return /databases/$(database)/documents/shared/$(sid)/private/links;
      }
      function isMember() {
        return signedIn() && exists(memberPath(request.auth.uid));
      }
      function roleOf(member) {
        return member.get('role', 'edit');
      }
      function myRole() {
        return roleOf(get(memberPath(request.auth.uid)).data);
      }
      function isEditor() {
        return isMember() && myRole() == 'edit';
      }
      function rolesIn(links) {
        return 'comment' in links || 'view' in links;
      }
      // The links once this request is done ({} for a share from before roles).
      function linksAfter() {
        return existsAfter(linksPath()) ? getAfter(linksPath()).data : {};
      }
      // `role`'s key is off, or this request changes it (for the edit key, the one in a share from before too).
      function keyChanged(role) {
        let before = exists(linksPath()) ? get(linksPath()).data : {};
        let old = get(sharePath()).data.get('link', null);
        return (before.get(role, null) == null || linksAfter().get(role, null) != before[role])
          && (role != 'edit' || old == null || !existsAfter(sharePath()) || getAfter(sharePath()).data.get('link', null) != old);
      }
      // A photo only from Google's photo server, so no one's photo can be an image on a server that
      // sees who looks at it (review 181-A M2).
      function googlePhoto(photo) {
        return photo == null || (photo is string && photo.size() <= 2000 && photo.matches('https://lh[0-9]+[.]googleusercontent[.]com/.*'));
      }
      // The name and photo Google gives the person (their sign-in token), as the app writes them
      // (personFrom): the name trimmed, cut to 200 characters, or 'Someone' when there is none; the
      // photo, or none. So no one shows up as someone else, the owner included (review 181-A M1).
      function ownName(name) {
        let given = request.auth.token.get('name', '');
        let trimmed = given is string ? given.trim() : '';
        return trimmed == '' ? name == 'Someone' : (name == trimmed || (trimmed.size() > 200 && name.size() <= 200));
      }
      function ownPhoto(photo) {
        return googlePhoto(photo) && (photo == null || photo == request.auth.token.get('picture', null));
      }
      function shareFields() {
        return request.resource.data.keys().hasOnly(['owner', 'root', 'link', 'data', 'client', 'rev', 'updatedAt'])
          && boardText(request.resource.data.data)
          && request.resource.data.client is string
          && (request.resource.data.link == null || (request.resource.data.link is string && !rolesIn(linksAfter())));
      }

      allow read: if isMember();
      allow create: if signedIn() && shareFields()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.root is string
        && request.resource.data.rev == 1
        && existsAfter(memberPath(request.auth.uid));
      // Every save counts up by one, so a page can't save over a newer version it hasn't seen.
      allow update: if isEditor() && shareFields()
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.root == resource.data.root
        && (request.resource.data.rev == resource.data.rev + 1
          || (request.resource.data.rev == resource.data.rev && request.resource.data.data == resource.data.data))
        && (request.resource.data.link == resource.data.link || resource.data.owner == request.auth.uid);
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      // Everyone who has it.
      match /members/{uid} {
        function share() {
          return getAfter(sharePath()).data;
        }
        function joinPath() {
          return /databases/$(database)/documents/shared/$(sid)/joins/$(uid);
        }
        // `key` is the current key of `role`'s link (the edit key may still be in a share from before).
        function keyFor(key, role) {
          return key is string
            && (key == linksAfter().get(role, null) || (role == 'edit' && key == share().get('link', null)));
        }
        function record() {
          let d = request.resource.data;
          return d.keys().hasOnly(['name', 'photo', 'key', 'role', 'joinedAt'])
            // The server's time when they joined (kept, or set again by an older copy of the app), so
            // no one sorts ahead of the owner (review 181-A M1).
            && (!('joinedAt' in d) || (d.joinedAt is timestamp
              && (d.joinedAt == request.time || (resource != null && d.joinedAt == resource.data.get('joinedAt', null)))))
            && d.name is string && d.name.size() <= 200 && ownName(d.name)
            && ownPhoto(d.get('photo', null))
            && (!('role' in d) || d.role in ['edit', 'comment', 'view'])
            // Everyone on it reads every member record, so once roles are in use none takes a new key
            // (an app from before roles writes the key someone opened, the owner's own included).
            && (!('key' in d) || !rolesIn(linksAfter()) || (resource != null && d.key == resource.data.get('key', null)));
        }
        function newRole() {
          return roleOf(request.resource.data);
        }
        allow read: if isMember();
        allow create, update: if signedIn() && request.auth.uid == uid && record()
          && (
            // The person who shared it, always an editor.
            (share().owner == uid && newRole() == 'edit')
            // Their own name or photo: the same role (and the same old key, if any).
            || (resource != null && newRole() == roleOf(resource.data)
              && request.resource.data.get('key', null) == resource.data.get('key', null))
            // Joining: the key in their joins record gives the role.
            || (existsAfter(joinPath()) && keyFor(getAfter(joinPath()).data.key, newRole()))
            // The app before roles: the edit key in the record, only while no comment or view link was made.
            || ('key' in request.resource.data && newRole() == 'edit' && !rolesIn(linksAfter())
              && keyFor(request.resource.data.key, 'edit'))
          );
        // The person who shared it changes someone else's role, and nothing else. Lowering someone
        // changes the keys of the roles above their new one in the same step (they may know them).
        allow update: if signedIn() && request.auth.uid != uid
          && get(sharePath()).data.owner == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['edit', 'comment', 'view']
          && (newRole() == 'edit'
            || (keyChanged('edit') && (newRole() == 'comment' || keyChanged('comment')))
            || (newRole() == 'comment' && roleOf(resource.data) == 'view'));
        // Leaving, or removed by the person who shared it: then every link that is on changes in the
        // same step (unless the share goes too), so their copy of a link never lets them back in.
        allow delete: if signedIn()
          && (request.auth.uid == uid
            || (get(sharePath()).data.owner == request.auth.uid
              && (!existsAfter(sharePath()) || (keyChanged('edit') && keyChanged('comment') && keyChanged('view')))));
      }

      // The key someone joined with: written by them together with their member record (so only on a
      // real join), read by nobody (only these rules look at it).
      match /joins/{uid} {
        allow create, update: if signedIn() && request.auth.uid == uid && existsAfter(memberPath(uid))
          && request.resource.data.keys().hasOnly(['key'])
          && request.resource.data.key is string && request.resource.data.key.size() <= 100;
        allow delete: if signedIn() && (request.auth.uid == uid || get(sharePath()).data.owner == request.auth.uid);
      }

      // The links: read by editors, written by the person who shared it, deleted only with the share.
      match /private/{name} {
        function keyOk(d, role) {
          return d.get(role, null) == null || (d[role] is string && d[role].size() >= 16 && d[role].size() <= 100);
        }
        function linksOk() {
          let d = request.resource.data;
          let e = d.get('edit', null);
          let c = d.get('comment', null);
          let v = d.get('view', null);
          return d.keys().hasOnly(['edit', 'comment', 'view'])
            && keyOk(d, 'edit') && keyOk(d, 'comment') && keyOk(d, 'view')
            && (e == null || (e != c && e != v)) && (c == null || c != v);
        }
        // D1: making the first comment or view link changes the edit key (every member can read the
        // member records, which may hold the old one), and the share itself then holds no key.
        function rolesOk() {
          let d = request.resource.data;
          let before = resource == null ? {} : resource.data;
          return !rolesIn(d)
            || (getAfter(sharePath()).data.get('link', null) == null
              && (rolesIn(before)
                || d.get('edit', null) == null
                || (d.edit != before.get('edit', null)
                  && (!exists(sharePath()) || d.edit != get(sharePath()).data.get('link', null)))));
        }
        allow read: if name == 'links' && isEditor();
        allow create, update: if name == 'links' && signedIn()
          && getAfter(sharePath()).data.owner == request.auth.uid
          && linksOk()
          && (resource == null || request.resource.data.keys().hasAll(resource.data.keys()))
          && rolesOk();
        allow delete: if name == 'links' && signedIn()
          && get(sharePath()).data.owner == request.auth.uid && !existsAfter(sharePath());
      }

      // Comments on its cards (D3: everyone on it reads them; editors and commenters write them).
      // Only `resolved` (with `resolvedAt`) ever changes: by an editor, or by a commenter on their
      // own comment (the app keeps a thread's state on its first comment). D5: no editing the text.
      match /comments/{cid} {
        function fresh() {
          let d = request.resource.data;
          return d.keys().hasOnly(['card', 'text', 'author', 'name', 'photo', 'at', 'resolved'])
            && d.keys().hasAll(['card', 'text', 'author', 'name', 'photo', 'at', 'resolved'])
            && d.author == request.auth.uid
            && d.card is string && d.card.matches('[A-Za-z0-9_-]{1,100}')
            && d.text is string && d.text.size() >= 1 && d.text.size() <= 1000
            // Their name and photo as on their member record, so no one posts as someone else.
            && d.name == get(memberPath(request.auth.uid)).data.name
            && d.photo == get(memberPath(request.auth.uid)).data.photo
            && googlePhoto(d.photo)
            && d.at == request.time
            && d.resolved == false;
        }
        function resolving() {
          let changed = request.resource.data.diff(resource.data).affectedKeys();
          return changed.hasOnly(['resolved', 'resolvedAt'])
            && request.resource.data.resolved is bool
            && (!changed.hasAny(['resolvedAt']) || request.resource.data.resolvedAt == request.time);
        }
        allow read: if isMember();
        // Not while their account is being deleted (review 181-A L3: it would outlive the account).
        allow create: if isMember() && myRole() in ['edit', 'comment'] && fresh() && !deleting(request.auth.uid);
        allow update: if isMember()
          && (myRole() == 'edit' || (myRole() == 'comment' && resource.data.author == request.auth.uid))
          && resolving();
        allow delete: if signedIn()
          && (resource.data.author == request.auth.uid || get(sharePath()).data.owner == request.auth.uid);
      }
    }

    // ---------- Feedback (job #69) ----------
    // A signed-in person can send a short note, as themselves, with their own email so the owner can
    // reply. No one can read, change or delete feedback from the app: the owner reads it in the
    // Firebase console.
    match /feedback/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['text', 'uid', 'email', 'sentAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000
        && request.resource.data.sentAt == request.time;
    }
  }
}
